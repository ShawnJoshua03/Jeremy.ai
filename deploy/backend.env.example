# systemd EnvironmentFile syntax: KEY=value, no export or shell expansion.
# Copy to /etc/jeremy/backend.env; keep root-owned, mode 0600.
DATABASE_URL=sqlite:////var/lib/jeremy/surgimentor.db
CONVEX_URL=
CONVEX_DEPLOY_KEY=
CARTESIA_API_KEY=
CARTESIA_MODEL_ID=sonic-3.6
CARTESIA_VOICE_ID=db6b0ed5-d5d3-463d-ae85-518a07d3c2b4
# Used by POST /coach; unset keeps the rule-based fallback coach.
GEMINI_API_KEY=
